# Required. User API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Required unless the worker only listens on 127.0.0.1 inside the container's network.
# Generate one with:  openssl rand -hex 32
WORKER_TOKEN=

# Model when a caller does not name one.
CURSOR_MODEL=composer-2.5

# Ceiling for what an agent may use. Callers can only narrow it.
#   full     everything (files, shell, web, MCP)
#   local    no web search / web fetch (shell can still reach the network)
#   offline  no web, no shell: files and MCP only
#   mcp      MCP tools only, no files
#   none     plain chat
TOOL_PROFILE=full

# Callers may send their own http/sse MCP servers with a job (never stdio).
ALLOW_REQUEST_MCP=true
# Callers may name a workspace that does not exist yet; it is created empty.
CREATE_WORKSPACES=true

MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=1800
# How long the MCP tool waits before answering "still running, here is the job_id".
# Keep it below the MCP client's tool timeout (Bifrost: 30 s by default).
MCP_WAIT_SECONDS=20

# Default workspace bound to a host folder (see the volume in docker-compose.yml).
# WORKSPACE_DIR=/workspace

# Clone a repository into the default workspace on first start.
# GIT_REPO=git@github.com:you/repo.git
# GIT_BRANCH=main
# GIT_SSH_KEY=/run/secrets/git_ssh
# GIT_TOKEN=
# GIT_USER_NAME=Cursor Worker
# GIT_USER_EMAIL=cursor-worker@localhost

# Extra standing instructions for every new agent.
# WORKER_INSTRUCTIONS=

# MCP servers at 127.0.0.1 on the host: rewrite to the Docker host.
# REWRITE_LOOPBACK_HOST=host.docker.internal
