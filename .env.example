# Required. User API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Required unless the worker only listens on 127.0.0.1 inside the container's network.
# Generate one with:  openssl rand -hex 32
WORKER_TOKEN=

# Model when a caller does not name one.
CURSOR_MODEL=composer-2.5

# Ceiling for what an agent may use. Callers can only narrow it.
#   full     everything (files, shell, web, MCP)
#   local    no web search / web fetch (shell can still reach the network)
#   offline  no web, no shell: files and MCP only
#   mcp      MCP tools only, no files
#   none     plain chat
TOOL_PROFILE=full

# Callers may send their own http/sse MCP servers with a job (never stdio).
ALLOW_REQUEST_MCP=true
# Callers may name a workspace that does not exist yet; it is created empty.
CREATE_WORKSPACES=true

MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=1800
# How long the MCP tool waits before answering "still running, here is the job_id".
# Keep it below the MCP client's tool timeout (Bifrost: 30 s by default).
MCP_WAIT_SECONDS=20

# Default workspace bound to a host folder (see the volume in docker-compose.yml).
# WORKSPACE_DIR=/workspace

# Clone a repository into the default workspace on first start.
# GIT_REPO=git@github.com:you/repo.git
# GIT_BRANCH=main
# GIT_SSH_KEY=/run/secrets/git_ssh
# GIT_TOKEN=
# GIT_USER_NAME=Cursor Worker
# GIT_USER_EMAIL=cursor-worker@localhost

# ---- SSH to your servers -------------------------------------------------------------------
# Use a key made for the worker (not your personal one), one per server or group, so you can
# revoke it alone. Each value is the content itself or a path to a mounted file.
# SSH_KEY=/run/secrets/worker_ssh_key
# SSH_KEYS_DIR=/run/secrets/ssh-keys          # several keys; refer to them as ~/.ssh/keys/<file>
# SSH_CONFIG=/run/secrets/ssh_config          # Host aliases, HostName, User, Port, IdentityFile
# SSH_KNOWN_HOSTS=/run/secrets/known_hosts    # pins host keys; without it the first key seen is kept
# SSH_STRICT_HOST_KEYS=yes                    # yes | accept-new

# Hosts where a job pauses before the first command until a human approves (patterns on the
# ssh alias or its HostName, comma separated). Approval holds for that host for the rest of the job.
# SSH_APPROVAL_HOSTS=prod-*,db01,10.0.1.*
# SSH_APPROVAL_TIMEOUT=900
# Let MCP callers pass the user's answer with a cursor_approve tool. Off by default: the calling
# model could approve on its own. Clients with elicitation ask the user directly either way.
# APPROVAL_TOOL=false

# Extra standing instructions for every new agent.
# WORKER_INSTRUCTIONS=

# MCP servers at 127.0.0.1 on the host: rewrite to the Docker host.
# REWRITE_LOOPBACK_HOST=host.docker.internal
